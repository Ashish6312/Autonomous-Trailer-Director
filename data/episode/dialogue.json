[
  {"dialogue_id": "DLG_001", "scene_id": "SC01", "speaker_id": "CHAR_BANSI", "start": "00:00:14.000", "end": "00:00:17.500", "text": "Arre! Is that Shankar's Meera, or am I finally going blind?", "tone": "playful", "importance": "medium", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_002", "scene_id": "SC01", "speaker_id": "CHAR_MEERA", "start": "00:00:18.200", "end": "00:00:21.000", "text": "Your eyes are fine, Bansi Kaka. It's me.", "tone": "warm", "importance": "medium", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": false, "notes": "'Kaka' is an honorific here, not kinship; subtitle localisation must not render it as 'uncle'."},
  {"dialogue_id": "DLG_003", "scene_id": "SC01", "speaker_id": "CHAR_BANSI", "start": "00:00:23.000", "end": "00:00:28.500", "text": "Six years I've delivered letters to that house. Not one ever came from you.", "tone": "wistful", "importance": "high", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_004", "scene_id": "SC01", "speaker_id": "CHAR_MEERA", "start": "00:00:30.000", "end": "00:00:33.000", "text": "Some things can't be written down, Kaka.", "tone": "reflective", "importance": "high", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": false, "notes": "'Kaka' is an honorific here, not kinship."},

  {"dialogue_id": "DLG_005", "scene_id": "SC02", "speaker_id": "CHAR_KAMLA", "start": "00:01:05.000", "end": "00:01:08.500", "text": "Meeru! Look at you - the city has eaten all your cheeks.", "tone": "affectionate", "importance": "medium", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_006", "scene_id": "SC02", "speaker_id": "CHAR_ARJUN", "start": "00:01:12.000", "end": "00:01:15.000", "text": "Guests usually send word before they come.", "tone": "cold", "importance": "high", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_007", "scene_id": "SC02", "speaker_id": "CHAR_MEERA", "start": "00:01:16.500", "end": "00:01:19.000", "text": "I'm not a guest, Arjun.", "tone": "hurt", "importance": "medium", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_008", "scene_id": "SC02", "speaker_id": "CHAR_ARJUN", "start": "00:01:20.000", "end": "00:01:24.000", "text": "Guests at least say goodbye when they leave.", "tone": "bitter", "importance": "high", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_009", "scene_id": "SC02", "speaker_id": "CHAR_KAMLA", "start": "00:01:35.000", "end": "00:01:41.000", "text": "Before he passed, your father wrote a letter. He said, open it only when Meera is home.", "tone": "solemn", "importance": "high", "spoiler_level": "none", "sensitive_content": [{"category": "sensitive_context", "severity": "mild", "note": "Mentions the father's death."}], "subtitle_safe": true},
  {"dialogue_id": "DLG_010", "scene_id": "SC02", "speaker_id": "CHAR_KAMLA", "start": "00:01:50.000", "end": "00:01:54.500", "text": "I kept it in this box for six years... It's gone.", "tone": "shocked", "importance": "high", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},

  {"dialogue_id": "DLG_011", "scene_id": "SC03", "speaker_id": "CHAR_KAMLA", "start": "00:02:18.000", "end": "00:02:22.000", "text": "Roll it thinner. Do they not have rotis in Delhi?", "tone": "teasing", "importance": "medium", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_012", "scene_id": "SC03", "speaker_id": "CHAR_MEERA", "start": "00:02:23.000", "end": "00:02:27.000", "text": "They have rotis, Maa. They just don't have you shouting at them.", "tone": "humorous", "importance": "high", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_013", "scene_id": "SC03", "speaker_id": "CHAR_KAMLA", "start": "00:02:35.000", "end": "00:02:40.000", "text": "Arjun left college the year you went. Someone had to milk the buffaloes.", "tone": "rueful", "importance": "medium", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_014", "scene_id": "SC03", "speaker_id": "CHAR_MEERA", "start": "00:02:45.000", "end": "00:02:49.000", "text": "I know, Maa. I know more than you think.", "tone": "guarded", "importance": "medium", "spoiler_level": "minor", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_015", "scene_id": "SC03", "speaker_id": "CHAR_KAMLA", "start": "00:02:55.000", "end": "00:03:02.000", "text": "Then tell me one thing. Why did my daughter leave without a single word?", "tone": "pleading", "importance": "high", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_016", "scene_id": "SC03", "speaker_id": "CHAR_MEERA", "start": "00:03:05.000", "end": "00:03:08.000", "text": "The dal is burning.", "tone": "deflecting", "importance": "medium", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},

  {"dialogue_id": "DLG_017", "scene_id": "SC04", "speaker_id": "CHAR_BANSI", "start": "00:03:25.000", "end": "00:03:30.000", "text": "Money order from Delhi, Raghav bhai. Twelve thousand, same as every month.", "tone": "matter-of-fact", "importance": "high", "spoiler_level": "minor", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_018", "scene_id": "SC04", "speaker_id": "CHAR_RAGHAV", "start": "00:03:31.000", "end": "00:03:34.500", "text": "Put it in my name. Like always.", "tone": "curt", "importance": "medium", "spoiler_level": "minor", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_019", "scene_id": "SC04", "speaker_id": "CHAR_RAGHAV", "start": "00:03:55.000", "end": "00:03:59.000", "text": "Some old letters had better stay buried.", "tone": "ominous", "importance": "high", "spoiler_level": "minor", "sensitive_content": [], "subtitle_safe": true},

  {"dialogue_id": "DLG_020", "scene_id": "SC05", "speaker_id": "CHAR_ARJUN", "start": "00:04:30.000", "end": "00:04:35.000", "text": "You left on the night of Papa's terahvi. The lamps were still burning.", "tone": "bitter", "importance": "high", "spoiler_level": "none", "sensitive_content": [{"category": "sensitive_context", "severity": "mild", "note": "Mourning ritual after a death."}], "subtitle_safe": false, "notes": "'Terahvi' is the thirteenth-day mourning ceremony; needs a localisation decision for non-regional subtitles."},
  {"dialogue_id": "DLG_021", "scene_id": "SC05", "speaker_id": "CHAR_MEERA", "start": "00:04:37.000", "end": "00:04:41.000", "text": "I had a train to catch, Arjun. I had a reason.", "tone": "strained", "importance": "medium", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_022", "scene_id": "SC05", "speaker_id": "CHAR_ARJUN", "start": "00:04:42.000", "end": "00:04:46.500", "text": "A reason? Maa sold her bangles while you found your reason.", "tone": "angry", "importance": "high", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_023", "scene_id": "SC05", "speaker_id": "CHAR_MEERA", "start": "00:04:55.000", "end": "00:05:00.000", "text": "If I told you, you'd hate someone else instead of me. I chose me.", "tone": "anguished", "importance": "high", "spoiler_level": "minor", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_024", "scene_id": "SC05", "speaker_id": "CHAR_ARJUN", "start": "00:05:10.000", "end": "00:05:14.000", "text": "Don't do that. Don't make leaving sound like a sacrifice.", "tone": "furious", "importance": "high", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},

  {"dialogue_id": "DLG_025", "scene_id": "SC06", "speaker_id": "CHAR_MEERA", "start": "00:05:45.000", "end": "00:05:50.000", "text": "Remember when Papa let you drive the tractor and you flattened Chacha's mustard?", "tone": "nostalgic", "importance": "high", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": false, "notes": "'Chacha' means father's younger brother (Raghav); must not be localised as a generic 'uncle' that could be confused with Bansi Kaka."},
  {"dialogue_id": "DLG_026", "scene_id": "SC06", "speaker_id": "CHAR_ARJUN", "start": "00:05:51.000", "end": "00:05:55.000", "text": "He didn't speak to me for a whole month. Best month of my life.", "tone": "dry humour", "importance": "high", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_027", "scene_id": "SC06", "speaker_id": "CHAR_MEERA", "start": "00:06:05.000", "end": "00:06:10.000", "text": "Papa used to say this tubewell hears everything and tells nothing.", "tone": "reflective", "importance": "medium", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},

  {"dialogue_id": "DLG_028", "scene_id": "SC07", "speaker_id": "CHAR_ARJUN", "start": "00:06:50.000", "end": "00:06:55.000", "text": "Kaka, who sends Chacha a money order every month?", "tone": "probing", "importance": "high", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": false, "notes": "Uses both 'Kaka' (honorific for Bansi) and 'Chacha' (kinship for Raghav) in one line."},
  {"dialogue_id": "DLG_029", "scene_id": "SC07", "speaker_id": "CHAR_BANSI", "start": "00:06:57.000", "end": "00:07:03.000", "text": "Postal rules, Munna. The sender's name is between the sender and the Sarkar.", "tone": "evasive humour", "importance": "medium", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_030", "scene_id": "SC07", "speaker_id": "CHAR_BANSI", "start": "00:07:10.000", "end": "00:07:16.000", "text": "But I'll tell you this. Last week your Chacha asked if any of Shankar's letters were still lying here.", "tone": "conspiratorial", "importance": "high", "spoiler_level": "minor", "sensitive_content": [], "subtitle_safe": true},

  {"dialogue_id": "DLG_031", "scene_id": "SC08", "speaker_id": "CHAR_MEERA", "start": "00:07:55.000", "end": "00:07:59.000", "text": "Looking for something, Chacha? Or hiding it?", "tone": "confrontational", "importance": "high", "spoiler_level": "minor", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_032", "scene_id": "SC08", "speaker_id": "CHAR_RAGHAV", "start": "00:08:05.000", "end": "00:08:10.000", "text": "You kept your promise for six years, Meera. Don't break it in one night.", "tone": "pleading", "importance": "high", "spoiler_level": "moderate", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_033", "scene_id": "SC08", "speaker_id": "CHAR_MEERA", "start": "00:08:15.000", "end": "00:08:19.000", "text": "Where is Papa's letter?", "tone": "demanding", "importance": "high", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_034", "scene_id": "SC08", "speaker_id": "CHAR_RAGHAV", "start": "00:08:25.000", "end": "00:08:30.000", "text": "Some truths burn a house down, beti.", "tone": "ominous", "importance": "high", "spoiler_level": "moderate", "sensitive_content": [{"category": "frightening", "severity": "mild"}, {"category": "misleading_context", "severity": "moderate", "note": "Metaphor; out of context it implies arson."}], "subtitle_safe": true},

  {"dialogue_id": "DLG_035", "scene_id": "SC09", "speaker_id": "CHAR_ARJUN", "start": "00:09:05.000", "end": "00:09:10.000", "text": "Twelve thousand every month from Delhi, and you call it your shop's profit?", "tone": "accusing", "importance": "high", "spoiler_level": "moderate", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_036", "scene_id": "SC09", "speaker_id": "CHAR_RAGHAV", "start": "00:09:12.000", "end": "00:09:15.000", "text": "Watch your tone, Munna. I held this family together.", "tone": "defensive", "importance": "medium", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_037", "scene_id": "SC09", "speaker_id": "CHAR_ARJUN", "start": "00:09:20.000", "end": "00:09:24.000", "text": "You held our letters. You bloody coward!", "tone": "enraged", "importance": "high", "spoiler_level": "minor", "sensitive_content": [{"category": "strong_language", "severity": "mild"}], "subtitle_safe": false, "notes": "Contains an insult; not suitable for burned-in subtitles in family placements."},
  {"dialogue_id": "DLG_038", "scene_id": "SC09", "speaker_id": "CHAR_KAMLA", "start": "00:09:35.000", "end": "00:09:38.000", "text": "Enough! Both of you - enough!", "tone": "desperate", "importance": "high", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},

  {"dialogue_id": "DLG_039", "scene_id": "SC10", "speaker_id": "CHAR_RAGHAV", "start": "00:10:25.000", "end": "00:10:30.000", "text": "Take it. I've carried it long enough.", "tone": "broken", "importance": "high", "spoiler_level": "moderate", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_040", "scene_id": "SC10", "speaker_id": "CHAR_ARJUN", "start": "00:10:40.000", "end": "00:10:48.000", "text": "(reading) 'If Meera is home, the house is safe. Raghav signed my name to a loan he could not repay.'", "tone": "stunned", "importance": "high", "spoiler_level": "major", "sensitive_content": [{"category": "sensitive_context", "severity": "moderate", "note": "Forgery and family debt."}], "subtitle_safe": true},
  {"dialogue_id": "DLG_041", "scene_id": "SC10", "speaker_id": "CHAR_ARJUN", "start": "00:10:55.000", "end": "00:11:03.000", "text": "(reading) 'Meera went to Delhi to pay it back, one money order at a time. Do not blame her for leaving. Blame me for asking.'", "tone": "breaking", "importance": "high", "spoiler_level": "major", "sensitive_content": [{"category": "sensitive_context", "severity": "moderate", "note": "Deathbed request."}], "subtitle_safe": true},
  {"dialogue_id": "DLG_042", "scene_id": "SC10", "speaker_id": "CHAR_KAMLA", "start": "00:11:15.000", "end": "00:11:19.000", "text": "Every rupee that kept this roof over us... was yours?", "tone": "devastated", "importance": "high", "spoiler_level": "major", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_043", "scene_id": "SC10", "speaker_id": "CHAR_MEERA", "start": "00:11:25.000", "end": "00:11:28.000", "text": "It was Papa's promise, Maa. I only kept it.", "tone": "tearful", "importance": "high", "spoiler_level": "major", "sensitive_content": [], "subtitle_safe": true},

  {"dialogue_id": "DLG_044", "scene_id": "SC11", "speaker_id": "CHAR_ARJUN", "start": "00:12:00.000", "end": "00:12:05.000", "text": "I said terrible things to you, Jiji.", "tone": "remorseful", "importance": "high", "spoiler_level": "moderate", "sensitive_content": [], "subtitle_safe": false, "notes": "'Jiji' (elder sister) marks the reconciliation; translating it loses the beat."},
  {"dialogue_id": "DLG_045", "scene_id": "SC11", "speaker_id": "CHAR_MEERA", "start": "00:12:08.000", "end": "00:12:12.000", "text": "You said them to the person you thought I was. That's allowed.", "tone": "gentle", "importance": "high", "spoiler_level": "moderate", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_046", "scene_id": "SC11", "speaker_id": "CHAR_ARJUN", "start": "00:12:25.000", "end": "00:12:30.000", "text": "You still make terrible tea, though.", "tone": "teasing", "importance": "medium", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},

  {"dialogue_id": "DLG_047", "scene_id": "SC12", "speaker_id": "CHAR_RAGHAV", "start": "00:13:05.000", "end": "00:13:11.000", "text": "I'm going to the bank, Bhabhi. Then to the panchayat. It should come from my own mouth.", "tone": "resolved", "importance": "medium", "spoiler_level": "moderate", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_048", "scene_id": "SC12", "speaker_id": "CHAR_BANSI", "start": "00:13:20.000", "end": "00:13:26.000", "text": "Registered post for Meera beti. From Delhi, and not in any hand I know.", "tone": "intrigued", "importance": "high", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true},
  {"dialogue_id": "DLG_049", "scene_id": "SC12", "speaker_id": "CHAR_MEERA", "start": "00:13:30.000", "end": "00:13:33.000", "text": "I know that handwriting.", "tone": "uneasy", "importance": "high", "spoiler_level": "none", "sensitive_content": [], "subtitle_safe": true}
]
