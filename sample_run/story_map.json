    "events": [
      {
        "event_id": "EVENT_01",
        "scene_id": "SC01",
        "description": "Meera steps off the early bus with her suitcase. Bansi Kaka, cycling past with the mail, recognises her and teases her about six years without a single letter.",
        "dramatic_function": "setup",
        "importance": "low",
        "spoiler_level": "none",
        "key_dialogue_ids": [
          "DLG_003",
          "DLG_004"
        ]
      },
      {
        "event_id": "EVENT_02",
        "scene_id": "SC02",
        "description": "Kamla embraces Meera; Arjun greets her coldly and calls her a guest. Kamla explains that Shankar left a letter to be opened only when Meera came home, then opens her tin box and finds it empty.",
        "dramatic_function": "inciting_incident",
        "importance": "high",
        "spoiler_level": "none",
        "key_dialogue_ids": [
          "DLG_006",
          "DLG_008",
          "DLG_009",
          "DLG_010"
        ]
      },
      {
        "event_id": "EVENT_03",
        "scene_id": "SC03",
        "description": "Kamla and Meera make rotis together and fall back into easy teasing. Kamla asks why Meera left; Meera deflects with a joke about the burning dal.",
        "dramatic_function": "relationship",
        "importance": "medium",
        "spoiler_level": "minor",
        "key_dialogue_ids": [
          "DLG_012",
          "DLG_015"
        ]
      },
      {
        "event_id": "EVENT_04",
        "scene_id": "SC04",
        "description": "Bansi delivers the monthly money order from Delhi, which Raghav signs for in his own name. Alone, Raghav unlocks his cash drawer, looks at Shankar's letter and locks it away again.",
        "dramatic_function": "mystery",
        "importance": "high",
        "spoiler_level": "minor",
        "key_dialogue_ids": [
          "DLG_017",
          "DLG_019"
        ]
      },
      {
        "event_id": "EVENT_05",
        "scene_id": "SC05",
        "description": "On the rooftop Arjun confronts Meera for leaving on the night of their father's terahvi while their mother sold her bangles. Meera insists she had a reason but will not say it.",
        "dramatic_function": "conflict",
        "importance": "high",
        "spoiler_level": "minor",
        "key_dialogue_ids": [
          "DLG_020",
          "DLG_022",
          "DLG_023",
          "DLG_024"
        ]
      },
      {
        "event_id": "EVENT_06",
        "scene_id": "SC06",
        "description": "At their father's tubewell the siblings share a memory of Arjun flattening Chacha's mustard crop with the tractor. The moment of warmth cools when Meera again avoids explaining herself.",
        "dramatic_function": "relationship",
        "importance": "low",
        "spoiler_level": "none",
        "key_dialogue_ids": [
          "DLG_025",
          "DLG_026"
        ]
      },
      {
        "event_id": "EVENT_07",
        "scene_id": "SC07",
        "description": "Arjun asks Bansi who sends Raghav money every month. Bansi cites postal rules but lets slip that Raghav recently asked whether any of Shankar's letters were still at the post office.",
        "dramatic_function": "investigation",
        "importance": "medium",
        "spoiler_level": "minor",
        "key_dialogue_ids": [
          "DLG_028",
          "DLG_030"
        ]
      },
      {
        "event_id": "EVENT_08",
        "scene_id": "SC08",
        "description": "Meera finds Raghav searching the storeroom with his ledger. She demands Papa's letter; he reminds her of a promise she has kept for six years and warns that some truths can burn a house down.",
        "dramatic_function": "conflict",
        "importance": "medium",
        "spoiler_level": "moderate",
        "key_dialogue_ids": [
          "DLG_031",
          "DLG_032",
          "DLG_033",
          "DLG_034"
        ]
      },
      {
        "event_id": "EVENT_09",
        "scene_id": "SC09",
        "description": "Arjun accuses Raghav of passing off Delhi money orders as shop profit and hiding their father's letters. He shoves Raghav, knocking the brass lantern to the ground where it shatters. Kamla stops them.",
        "dramatic_function": "conflict",
        "importance": "high",
        "spoiler_level": "moderate",
        "key_dialogue_ids": [
          "DLG_035",
          "DLG_037",
          "DLG_038"
        ]
      },
      {
        "event_id": "EVENT_10",
        "scene_id": "SC10",
        "description": "Raghav hands the letter to Arjun, who reads it aloud: Raghav forged Shankar's signature on a loan against the house, and Meera left to repay it in secret at their father's request. Kamla realises the family has lived on Meera's money.",
        "dramatic_function": "reveal",
        "importance": "high",
        "spoiler_level": "major",
        "key_dialogue_ids": [
          "DLG_039",
          "DLG_040",
          "DLG_041",
          "DLG_042",
          "DLG_043"
        ]
      },
      {
        "event_id": "EVENT_11",
        "scene_id": "SC11",
        "description": "At dawn Arjun apologises to Meera, calling her Jiji for the first time in the episode. She forgives him, and he teases her about her tea.",
        "dramatic_function": "resolution",
        "importance": "medium",
        "spoiler_level": "moderate",
        "key_dialogue_ids": [
          "DLG_044",
          "DLG_045"
        ]
      },
      {
        "event_id": "EVENT_12",
        "scene_id": "SC12",
        "description": "Raghav leaves to confess to the bank and the panchayat. As he goes, Bansi arrives with a registered letter for Meera from Delhi; Meera recognises the handwriting and goes pale.",
        "dramatic_function": "cliffhanger",
        "importance": "medium",
        "spoiler_level": "moderate",
        "key_dialogue_ids": [
          "DLG_048",
          "DLG_049"
        ]
      }
    ],
