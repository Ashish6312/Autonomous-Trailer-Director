    "trailer_hooks": [
      {
        "dialogue_id": "DLG_003",
        "scene_id": "SC01",
        "speaker_id": "CHAR_BANSI",
        "text": "Six years I've delivered letters to that house. Not one ever came from you.",
        "tone": "wistful",
        "spoiler_level": "none",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_004",
        "scene_id": "SC01",
        "speaker_id": "CHAR_MEERA",
        "text": "Some things can't be written down, Kaka.",
        "tone": "reflective",
        "spoiler_level": "none",
        "subtitle_safe": false
      },
      {
        "dialogue_id": "DLG_006",
        "scene_id": "SC02",
        "speaker_id": "CHAR_ARJUN",
        "text": "Guests usually send word before they come.",
        "tone": "cold",
        "spoiler_level": "none",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_008",
        "scene_id": "SC02",
        "speaker_id": "CHAR_ARJUN",
        "text": "Guests at least say goodbye when they leave.",
        "tone": "bitter",
        "spoiler_level": "none",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_009",
        "scene_id": "SC02",
        "speaker_id": "CHAR_KAMLA",
        "text": "Before he passed, your father wrote a letter. He said, open it only when Meera is home.",
        "tone": "solemn",
        "spoiler_level": "none",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_010",
        "scene_id": "SC02",
        "speaker_id": "CHAR_KAMLA",
        "text": "I kept it in this box for six years... It's gone.",
        "tone": "shocked",
        "spoiler_level": "none",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_012",
        "scene_id": "SC03",
        "speaker_id": "CHAR_MEERA",
        "text": "They have rotis, Maa. They just don't have you shouting at them.",
        "tone": "humorous",
        "spoiler_level": "none",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_015",
        "scene_id": "SC03",
        "speaker_id": "CHAR_KAMLA",
        "text": "Then tell me one thing. Why did my daughter leave without a single word?",
        "tone": "pleading",
        "spoiler_level": "none",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_017",
        "scene_id": "SC04",
        "speaker_id": "CHAR_BANSI",
        "text": "Money order from Delhi, Raghav bhai. Twelve thousand, same as every month.",
        "tone": "matter-of-fact",
        "spoiler_level": "minor",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_019",
        "scene_id": "SC04",
        "speaker_id": "CHAR_RAGHAV",
        "text": "Some old letters had better stay buried.",
        "tone": "ominous",
        "spoiler_level": "minor",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_020",
        "scene_id": "SC05",
        "speaker_id": "CHAR_ARJUN",
        "text": "You left on the night of Papa's terahvi. The lamps were still burning.",
        "tone": "bitter",
        "spoiler_level": "none",
        "subtitle_safe": false
      },
      {
        "dialogue_id": "DLG_022",
        "scene_id": "SC05",
        "speaker_id": "CHAR_ARJUN",
        "text": "A reason? Maa sold her bangles while you found your reason.",
        "tone": "angry",
        "spoiler_level": "none",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_023",
        "scene_id": "SC05",
        "speaker_id": "CHAR_MEERA",
        "text": "If I told you, you'd hate someone else instead of me. I chose me.",
        "tone": "anguished",
        "spoiler_level": "minor",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_024",
        "scene_id": "SC05",
        "speaker_id": "CHAR_ARJUN",
        "text": "Don't do that. Don't make leaving sound like a sacrifice.",
        "tone": "furious",
        "spoiler_level": "none",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_025",
        "scene_id": "SC06",
        "speaker_id": "CHAR_MEERA",
        "text": "Remember when Papa let you drive the tractor and you flattened Chacha's mustard?",
        "tone": "nostalgic",
        "spoiler_level": "none",
        "subtitle_safe": false
      },
      {
        "dialogue_id": "DLG_026",
        "scene_id": "SC06",
        "speaker_id": "CHAR_ARJUN",
        "text": "He didn't speak to me for a whole month. Best month of my life.",
        "tone": "dry humour",
        "spoiler_level": "none",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_028",
        "scene_id": "SC07",
        "speaker_id": "CHAR_ARJUN",
        "text": "Kaka, who sends Chacha a money order every month?",
        "tone": "probing",
        "spoiler_level": "none",
        "subtitle_safe": false
      },
      {
        "dialogue_id": "DLG_030",
        "scene_id": "SC07",
        "speaker_id": "CHAR_BANSI",
        "text": "But I'll tell you this. Last week your Chacha asked if any of Shankar's letters were still lying here.",
        "tone": "conspiratorial",
        "spoiler_level": "minor",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_031",
        "scene_id": "SC08",
        "speaker_id": "CHAR_MEERA",
        "text": "Looking for something, Chacha? Or hiding it?",
        "tone": "confrontational",
        "spoiler_level": "minor",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_033",
        "scene_id": "SC08",
        "speaker_id": "CHAR_MEERA",
        "text": "Where is Papa's letter?",
        "tone": "demanding",
        "spoiler_level": "none",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_037",
        "scene_id": "SC09",
        "speaker_id": "CHAR_ARJUN",
        "text": "You held our letters. You bloody coward!",
        "tone": "enraged",
        "spoiler_level": "minor",
        "subtitle_safe": false
      },
      {
        "dialogue_id": "DLG_038",
        "scene_id": "SC09",
        "speaker_id": "CHAR_KAMLA",
        "text": "Enough! Both of you - enough!",
        "tone": "desperate",
        "spoiler_level": "none",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_048",
        "scene_id": "SC12",
        "speaker_id": "CHAR_BANSI",
        "text": "Registered post for Meera beti. From Delhi, and not in any hand I know.",
        "tone": "intrigued",
        "spoiler_level": "none",
        "subtitle_safe": true
      },
      {
        "dialogue_id": "DLG_049",
        "scene_id": "SC12",
        "speaker_id": "CHAR_MEERA",
        "text": "I know that handwriting.",
        "tone": "uneasy",
        "spoiler_level": "none",
        "subtitle_safe": true
      }
    ],
